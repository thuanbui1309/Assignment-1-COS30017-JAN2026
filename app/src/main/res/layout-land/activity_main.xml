<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_gym"
        android:contentDescription="@string/app_name" />

    <!-- Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_overlay" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="48dp"
        android:layout_marginStart="24dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/title_main"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="italic" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- Score and Progress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Score -->
            <TextView
                android:id="@+id/tvScoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:text="@string/label_score"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="120sp"
                android:gravity="center"
                android:layout_gravity="center_horizontal"/>

            <!-- Element -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvElementLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/label_element_header"
                    android:textColor="#90A4AE"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvElement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="1 / 10"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Progress -->
            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_basic" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive" android:layout_marginEnd="2dp"/>
                <View android:id="@+id/seg10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/zone_inactive"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp">

            <Button
                android:id="@+id/btnPerform"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:text="@string/btn_perform"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnDeduction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary_danger"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:text="@string/btn_deduction"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_reset"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_refresh___custom"
                android:drawablePadding="12dp"
                android:paddingStart="24dp"
                android:text="@string/btn_reset"
                android:textColor="#4FC3F7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
